{
  "name": "ubc-vpn-app",
  "productName": "UBC VPN",
  "description": "The UBC VPN desktop app",
  "version": "0.1.0",
  "private": true,
  "license": "MIT OR Apache-2.0",
  "main": "out/main/index.js",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "demo": "electron-vite dev --mode demo",
    "build": "electron-vite build",
    "build:demo": "electron-vite build --mode demo --outDir out-demo",
    "check:build": "node scripts/check-production-build.mjs",
    "check:build:control": "node scripts/check-production-build.mjs --control",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.e2e.json",
    "test": "vitest run",
    "test:e2e": "pnpm build && pnpm build:demo && playwright test",
    "test:system": "pnpm build && playwright test -c playwright.system.config.ts",
    "check:licenses": "node scripts/check-licenses.mjs",
    "package:win": "node node_modules/electron/install.js && pnpm build && pnpm check:build && electron-builder --win --publish never",
    "check:package": "node scripts/check-package.mjs dist/win-unpacked dist"
  },
  "dependencies": {
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@radix-ui/react-tooltip": "1.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.55.0",
    "motion": "14.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@electron/fuses": "2.1.3",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "7.3.7",
    "vitest": "5.0.3"
  }
}
