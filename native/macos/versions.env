# Pinned inputs for build.sh and bundle.sh. Change a version and its checksum together.

# Oldest macOS the libraries must run on.
MACOS_MIN=13.0

# openconnect is fetched with git, so the commit is the checksum.
# The script checks that the tag still points at it.
OPENCONNECT_VERSION=9.21
OPENCONNECT_REPO=https://gitlab.com/openconnect/openconnect.git
OPENCONNECT_COMMIT=8b702bf2dbaf11302ed98629214b1df5d50a12aa

GNUTLS_VERSION=3.8.13
GNUTLS_URL=https://www.gnupg.org/ftp/gcrypt/gnutls/v3.8/gnutls-3.8.13.tar.xz
GNUTLS_SHA256=ffed8ec1bf09c2426d4f14aae377de4753b53e537d685e604e99a8b16ca9c97e

NETTLE_VERSION=4.0
NETTLE_URL=https://ftp.gnu.org/gnu/nettle/nettle-4.0.tar.gz
NETTLE_SHA256=3addbc00da01846b232fb3bc453538ea5468da43033f21bb345cb1e9073f5094

GMP_VERSION=6.3.0
GMP_URL=https://ftp.gnu.org/gnu/gmp/gmp-6.3.0.tar.xz
GMP_SHA256=a3c2b80201b89e68616f4ad30bc66aee4927c3ce50e33929ca819d5c43538898
