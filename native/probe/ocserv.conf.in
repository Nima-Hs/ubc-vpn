auth = "plain[passwd=@DIR@/passwd]"
tcp-port = 4443
udp-port = 4443
run-as-user = nobody
run-as-group = @GROUP@
socket-file = @DIR@/ocserv.sock
pid-file = @DIR@/ocserv.pid
server-cert = @DIR@/cert.pem
server-key = @DIR@/key.pem
isolate-workers = false
max-clients = 4
max-same-clients = 2
keepalive = 300
dpd = 60
mobile-dpd = 300
try-mtu-discovery = false
cookie-timeout = 300
rekey-time = 172800
device = @DEVICE@
default-domain = example.test
ipv4-network = 10.99.0.0
ipv4-netmask = 255.255.255.0
dns = 10.99.0.1
route = 10.50.0.0/255.255.0.0
route = 192.168.77.0/255.255.255.0
cisco-client-compat = true
